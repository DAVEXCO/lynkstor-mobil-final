# Copier vers secrets.local.env (ne pas committer)
# Settings → API → service_role (secret)

SUPABASE_URL=https://COLLEZ_ICI_LE_project_ref.supabase.co
SUPABASE_PROJECT_REF=COLLEZ_ICI_LE_project_ref
SUPABASE_ANON_KEY=COLLEZ_ICI_LA_CLE_anon
SUPABASE_SERVICE_ROLE_KEY=COLLEZ_ICI_LA_CLE_service_role

# Secrets Edge Function (dashboard → Edge Functions → Secrets)
ADMIN_API_KEY=change-me-long-random-admin-key
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
WEBHOOK_SECRET=change-me-webhook-hmac-secret

# Cloudflare Wrangler (alternative au flux OAuth localhost)
CLOUDFLARE_ACCOUNT_ID=COLLEZ_ICI_L_ID_DU_COMPTE
CLOUDFLARE_API_TOKEN=COLLEZ_ICI_LE_JETON_API
