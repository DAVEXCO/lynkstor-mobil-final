# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Server secrets & local DB
server/.env
server/node_modules/
server/*.db
server/*.db-journal

# Supabase / Cloudflare deploy secrets & bundle
supabase/.secrets.env
supabase/.temp
deploy/secrets.local.env
deploy/PROJECT.env
deploy/cloudflare/dist/

# Local AI models — GGUF are fetched at APK build time, never committed
models/
*.gguf
tool/.cache/


# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Keystore backup memo (local only)
secrets/

# Android signing — NEVER commit the release key or its passwords
android/key.properties
!android/key.properties.example
*.jks
*.keystore
# Machine-specific SDK path
android/local.properties

.neon
.env.local
node_modules/

# Tooling caches
.wrangler/
.qoder/
deploy/cloudflare/.probe-*.json
