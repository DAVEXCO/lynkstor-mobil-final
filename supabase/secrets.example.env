# Secrets Edge Functions — à définir via CLI ou Dashboard Supabase
# supabase secrets set --env-file supabase/secrets.example.env
# (renommez / copiez sans le .example et mettez de vraies valeurs)

ADMIN_API_KEY=change-me-long-random-admin-key
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
WEBHOOK_SECRET=change-me-webhook-hmac-secret

# Optionnel (sinon = ADMIN_API_KEY)
# SYNC_API_KEY=change-me-sync-key

# DEV uniquement
# SKIP_WEBHOOK_VERIFY=true
