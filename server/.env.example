# Copier vers .env et adapter avant démarrage
# cp .env.example .env

NODE_ENV=development
PORT=3001

# Dossier SQLite (Docker utilise /app/data)
# DATA_DIR=./data

# Obligatoire en production (le process refuse de démarrer sans)
ADMIN_API_KEY=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password

# Optionnel : clé dédiée sync mobile (sinon = ADMIN_API_KEY)
# SYNC_API_KEY=change-me-sync-key

# Secret HMAC pour X-Webhook-Signature: sha256=<hex>
WEBHOOK_SECRET=change-me-webhook-hmac-secret

# Admin sur un autre domaine (Cloudflare Pages) :
# CORS_ORIGIN=https://lynkstor-admin.pages.dev
# Laisser vide si monolithe (API + admin même origine)

# DEV UNIQUEMENT — ne jamais activer en production
# SKIP_WEBHOOK_VERIFY=true
